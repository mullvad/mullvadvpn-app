#!/usr/bin/env bash

set -eu

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ANDROID_ROOT="$( cd "$SCRIPT_DIR/../.." && pwd )"
cd "$SCRIPT_DIR"

# shellcheck disable=SC1091
source ../../../scripts/utils/log

# shellcheck disable=SC1091
source ../../../scripts/utils/localization_utils

# Identifier of the Crowdin bundle that exports relay locations as Android
# XML. Relay locations are translated via the shared desktop source file
# (relay-locations.pot).
RELAY_BUNDLE_ID=2

RESOURCES_DIR="lib/ui/resource/src/main/res"

print_usage() {
  log "Usage: $(basename "$0") <command> [options]"
  log "Commands:"
  log "  upload                    Upload source strings to Crowdin"
  log "  download [-s]             Download translations from Crowdin, check for"
  log "                            missing translations and commit the changes"
  log "  download-relay-locations  Download relay locations from Crowdin"
  log ""
  log "Options:"
  log "  -s, --skip-missing-check  Skip the missing translations check. Only use"
  log "                            this when the check is known to fail."
  log ""
  log "Both download commands commit their changes to the current branch."
  log ""
  log "Make sure enviroment variable CROWDIN_API_KEY is set before invoking this"
  log "script. E.g:"
  log "$ CROWDIN_API_KEY=1234 $(basename "$0") <command>"
}

function main {
    case ${1:-""} in
        upload) upload_to_crowdin;;
        download)
            shift
            local skip_missing_check=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    -s|--skip-missing-check)
                        skip_missing_check=true
                        ;;
                    *)
                        log_error "Unsupported argument for download: \`$1\`"
                        usage >&2
                        exit 1
                        ;;
                esac
                shift
            done
            download_from_crowdin "$skip_missing_check"
            ;;
        download-relay-locations) download_relay_locations;;
        -h|--help) print_usage;;
        "")
            print_usage
            ;;
        *)
            log_error "Unknown command: $1"
            print_usage >&2
            exit 1
            ;;
    esac
}

function upload_to_crowdin {
    ensure_crowdin_api_key

    log_header "Uploading translations to crowdin"

    crowdin upload sources
}

function download_from_crowdin {
    local skip_missing_check=$1

    ensure_crowdin_api_key

    log_header "Downloading translations from crowdin"
    crowdin download

    download_relay_locations

    if [ "$skip_missing_check" = false ]; then
        log_header "Checking for missing translations"
        pushd "$ANDROID_ROOT"
        ./gradlew -Pmullvad.app.lint.failOnMissingTranslations=true :lib:ui:resource:lintDebug
        popd
    else
        log_warn "Skipping check for missing translations"
    fi

    commit_changes "Update Android translations"
}

function download_relay_locations {
    ensure_crowdin_api_key

    log_header "Downloading relay locations from crowdin"
    crowdin bundle download "$RELAY_BUNDLE_ID"

    normalize_relay_locations
}

function normalize_relay_locations {
    # Crowdin always places the source language export under its own language
    # code directory, so move the English export to the default resource
    # directory, which is what Android falls back to.
    local en_export="$ANDROID_ROOT/en/$RESOURCES_DIR/xml/relay_locations.xml"
    if [ -f "$en_export" ]; then
        mv "$en_export" "$ANDROID_ROOT/$RESOURCES_DIR/xml/relay_locations.xml"
        rm -rf "$ANDROID_ROOT/en"
    fi

    # Depending on how the project level language mapping resolves
    # %two_letters_code% for Chinese, the exports may end up in xml-zh-CN and
    # xml-zh-TW instead of the directories Android expects. Move them to the
    # directories matching Android's locale codes.
    normalize_relay_language "zh-CN" "zh-rCN"
    normalize_relay_language "zh-TW" "zh-rTW"
}

function normalize_relay_language {
    local exported_dir="$ANDROID_ROOT/$RESOURCES_DIR/xml-$1"
    local resource_dir="$ANDROID_ROOT/$RESOURCES_DIR/xml-$2"
    if [ -f "$exported_dir/relay_locations.xml" ]; then
        mv "$exported_dir/relay_locations.xml" "$resource_dir/relay_locations.xml"
        rm -rf "$exported_dir"
    fi
}

main "$@"
