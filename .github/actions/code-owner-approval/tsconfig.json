{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es2022",
    "lib": ["es6", "dom.iterable"],
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "exclude": ["test/**"]
}
